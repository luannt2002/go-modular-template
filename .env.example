# Sao chép thành .env (đã bị .gitignore) hoặc đặt biến môi trường trực tiếp.
APP_ENV=local
HTTP_ADDR=:8080
LOG_LEVEL=info
# Bắt buộc, tối thiểu 16 ký tự. Tạo ngẫu nhiên: openssl rand -hex 24
AUTH_TOKEN=

# --- Tuỳ chọn: đọc cấu hình từ Vault (có VAULT_ADDR thì Vault thắng env) ---
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_PATHS=shared,go-modular-template
# VAULT_KV_MOUNT=secret
# VAULT_TOKEN=            # hoặc dùng AppRole:
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# VAULT_CACERT=/etc/ssl/vault-ca.pem
